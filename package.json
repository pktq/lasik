{
  "name": "lasik-agents",
  "version": "0.2.1",
  "description": "LASIK (LLM Agent Sight In Kode): restores the sight of AI reverse-engineering agents blinded by BLA. Statically undoes every BLA shield (JS bundles, Electron/ASAR, WebAssembly, Python/.pyc, native ELF/PE/Mach-O, SQLite, models, APK/DEX, JVM, .NET, BEAM, EVM, PCAP and more) and prompt-firewalls the decoy text so REA can read them again.",
  "keywords": [
    "lasik",
    "anti-bla",
    "bla",
    "rea",
    "reverse-engineering",
    "deobfuscation",
    "deobfuscator",
    "prompt-injection",
    "llm-security",
    "malware-analysis",
    "mcp",
    "mcp-server",
    "agent-skills",
    "claude-code",
    "cursor",
    "codex"
  ],
  "homepage": "https://github.com/pktq/lasik#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pktq/lasik.git"
  },
  "bugs": {
    "url": "https://github.com/pktq/lasik/issues"
  },
  "license": "MIT",
  "author": "LASIK Contributors",
  "type": "module",
  "bin": {
    "lasik": "./dist/cli.js",
    "lasik-agents": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".agents/skills/lasik",
    "README.md",
    "LICENSE",
    "DISCLAIMER.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node dist/cli.js bench",
    "prepublishOnly": "npm run build && npm test",
    "coverage:docs": "node scripts/bla-coverage.mjs docs",
    "coverage:check": "node scripts/bla-coverage.mjs check",
    "bench:real": "node scripts/bench-real.mjs"
  },
  "dependencies": {
    "@babel/generator": "^8.1.0",
    "@babel/parser": "^8.1.0",
    "@babel/traverse": "^8.1.0",
    "@babel/types": "^8.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "mcpName": "io.github.pktq/lasik"
}
